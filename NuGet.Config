<!--
  This repo's package sources are cleared here so a plain library build
  (no PackageReference items) can restore offline. It doesn't affect the
  test project, which does reference packages and needs a real feed;
  see tools/AdapterHarness/README.md for why testing works differently
  right now.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
