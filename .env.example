# OpenFGA connection (used when wiring the real IAuthorizationStore adapter,
# src/Tessera.ControlPlane/OpenFga/OpenFgaAuthorizationStore.cs, and by
# Tessera.Service to switch off the in-memory store)
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
OPENFGA_API_TOKEN=

# Identity resolution
TESSERA_CLIENT_CLAIM=client_id
TESSERA_CLIENT_HEADER=x-client-ref

# Audit
TESSERA_AUDIT_SINK=console

# Tessera.Service (src/Tessera.Service): the minimal HTTP surface for
# onboard/kill/restore. TESSERA_JWT_SIGNING_KEY is required, base64, at
# least 32 bytes, the service refuses to start without it.
TESSERA_JWT_SIGNING_KEY=
TESSERA_JWT_ISSUER=tessera
TESSERA_JWT_AUDIENCE=tessera-clients
TESSERA_ENDPOINT_CATALOG_PATH=
